# /etc/profile - System-wide .profile for login shells

# Set up environment
export LANG=en_US.UTF-8
export LC_ALL=C

# XDG directories
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"

# Create XDG directories if they don't exist
mkdir -p "$XDG_CONFIG_HOME"
mkdir -p "$XDG_DATA_HOME"
mkdir -p "$XDG_CACHE_HOME"

# Load profiles in /etc/profile.d/
if [ -d /etc/profile.d/ ]; then
    for profile in /etc/profile.d/*.sh; do
        if [ -r "$profile" ]; then
            . "$profile"
        fi
    done
    unset profile
fi

# Set default file creation mask
umask 022

# Gaming optimizations
alias gamemode='gamemoderun'
alias mangohud='MANGOHUD=1 mangohud'

# Welcome message
if [ -z "$INSIDE_NOVASYSTEM" ]; then
    if [ "$(id -u)" -eq 0 ]; then
        echo "NovaOS Gaming Edition - Root Shell"
        echo "Type 'exit' to logout, 'reboot' to restart"
    else
        echo "Welcome to NovaOS Gaming Edition"
        neofetch 2>/dev/null || echo "Run 'neofetch' for system info"
    fi
fi
