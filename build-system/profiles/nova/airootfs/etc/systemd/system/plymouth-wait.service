[Unit]
Description=Wait for Plymouth
After=plymouth-manager.service
After=plymouth-start.service
Before=multi-user.target
Before=graphical.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/plymouth wait --timeout=10

[Install]
WantedBy=multi-user.target
WantedBy=graphical.target
